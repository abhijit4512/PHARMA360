
# Twilio notifications (configure in backend/.env; never commit real secrets)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional API Key authentication; if both are supplied they take precedence over Auth Token.
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID=
# Leave false for Twilio Trial/Sandbox. Enable only for approved templates with variables on an eligible account.
TWILIO_WHATSAPP_USE_VARIABLES=false
# If true, the assigned branch phone also receives WhatsApp order alerts (must be eligible/opted-in).
PHARMA360_BRANCH_WHATSAPP_ENABLED=false
# Optional admin/super-admin alert phone, E.164 format
PHARMA360_ADMIN_ALERT_PHONE=

# Customer email notification delivery (optional SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
